{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./.local/lib/hindsight/hindsight-hook.py\" recall --agent codex",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./.local/lib/hindsight/hindsight-hook.py\" retain --agent codex",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
