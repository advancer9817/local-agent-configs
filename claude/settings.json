{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "[REDACTED]",
    "ANTHROPIC_BASE_URL": "http://35.194.237.91:8317",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-opus-5-5[1M]",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gemini-3.8-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "gemini-3.8-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gemini-3.8-flash[1M]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "gemini-3.8-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gemini-3.8-flash[1M]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "gemini-3.8-flash",
    "ANTHROPIC_MODEL": "gemini-3.8-flash[1M]",
    "CLAUDE_CODE_DISABLE_BACKGROUND_AGENTS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_ENABLE_SUBAGENTS": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "gemini-3.8-flash[1M]",
    "LANG": "zh_CN.UTF-8",
    "LC_ALL": "zh_CN.UTF-8",
    "NO_PROXY": "localhost,127.0.0.1",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "modelPicker": {
    "options": [
      {
        "behavesAs": "claude-3-7-sonnet-20250219",
        "label": "Gemini 3.8 Flash",
        "model": "gemini-3.8-flash"
      },
      {
        "behavesAs": "claude-3-7-sonnet-20250219",
        "label": "Gemini 3.8 Flash Normal",
        "model": "gemini-3.8-flash-n"
      }
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./.local/lib/hindsight/hindsight-hook.py\" recall --agent claude",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./.local/lib/hindsight/hindsight-hook.py\" retain --agent claude",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"./.claude/statusline.sh\" 2>/dev/null"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "gpt-6.1-sol": {
      "effortLevel": "medium"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "verbose": false,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {}
}
