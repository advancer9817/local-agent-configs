{
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "PROXY_MANAGED",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:15721",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5[1M]",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "gemini-3.8-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "gemini-3.8-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5[1M]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "gemini-3.8-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5[1M]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "gemini-3.8-flash",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "gemini-3.8-flash[1M]",
    "HTTPS_PROXY": "http://172.20.0.1:7890",
    "HTTP_PROXY": "http://172.20.0.1:7890",
    "LANG": "zh_CN.UTF-8",
    "LC_ALL": "zh_CN.UTF-8",
    "MCORE_AGENT_ID": "claude",
    "MCORE_PORT": "8318",
    "NO_PROXY": "localhost,127.0.0.1",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "MCORE_AGENT_ID=claude bash /home/advancer/project/memorycore/scripts/hooks/session-start.sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 /home/advancer/project/memorycore/scripts/hooks/mcore-ingest.py --agent claude --background",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "MCORE_AGENT_ID=claude bash /home/advancer/project/memorycore/scripts/hooks/mcore-context.sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "memorycore": {
      "type": "http",
      "url": "http://127.0.0.1:8318/mcp"
    }
  },
  "model": "opus",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash /home/advancer/gdrive/claude-shared/statusline.sh",
    "type": "command"
  },
  "theme": "dark-ansi",
  "verbose": false,
  "worktree": {
    "bgIsolation": "none"
  }
}