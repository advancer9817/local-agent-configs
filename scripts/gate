#!/usr/bin/env bash
# ==============================================================================
# gate: Superpowers 开工硬门禁与工具排版智能中枢控制开关
# ==============================================================================
set -euo pipefail

FLAG_DIR="${HOME}/.hermes/flags"
MODE_FILE="${FLAG_DIR}/gate_mode"
DISABLED_FILE="${FLAG_DIR}/superpowers_gate.disabled"

mkdir -p "${FLAG_DIR}"

get_mode() {
    if [ -f "${DISABLED_FILE}" ]; then
        echo "off"
    elif [ -f "${MODE_FILE}" ]; then
        local val
        val="$(cat "${MODE_FILE}" 2>/dev/null | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
        echo "${val:-off}"
    else
        echo "off"
    fi
}

cmd="${1:-toggle}"

case "${cmd}" in
    toggle)
        curr="$(get_mode)"
        if [ "${curr}" = "off" ]; then
            rm -f "${DISABLED_FILE}"
            echo "auto" > "${MODE_FILE}"
            echo "🤖 门禁已一键切换为: 【AUTO 智能自适应模式】"
            echo "   • 高等模型 (Opus/Sonnet/Flash等): 仅保留硬门禁，自动静默排版废话"
            echo "   • 小模型: 自动补齐排版防黑盒"
        else
            rm -f "${DISABLED_FILE}"
            echo "off" > "${MODE_FILE}"
            echo "⚡ 门禁已一键切换为: 【OFF 强制全关闭】"
            echo "   • 每轮注入 0 字符，解除前置刹车与排版约束，自由直接交付"
        fi
        ;;
    auto)
        rm -f "${DISABLED_FILE}"
        echo "auto" > "${MODE_FILE}"
        echo "🤖 门禁与排版规则已切换为【AUTO 智能自适应模式】"
        echo "   -> 高等模型 (Opus / Sonnet / Flash / GPT-4o 等): 仅保留硬门禁，自动静默排版废话"
        echo "   -> 轻量模型: 自动全量注入排版规范，防黑盒哑巴调用"
        ;;
    off)
        rm -f "${DISABLED_FILE}"
        echo "off" > "${MODE_FILE}"
        echo "⚡ 门禁与排版规则已【强制全关闭】(FORCE DISABLED)"
        echo "   -> 每轮注入 0 字符，彻底解除前置刹车与排版格式约束，自主直接交付"
        ;;
    on)
        rm -f "${DISABLED_FILE}"
        echo "on" > "${MODE_FILE}"
        echo "🛡️ 门禁与排版规则已【强制全开启】(FORCE ENABLED)"
        echo "   -> 无论任何模型，每轮强制注入硬门禁 + 工具空行自然分段透明规范"
        ;;
    status)
        curr="$(get_mode)"
        echo "=================================================="
        echo "  Hermes 门禁与工具排版智能中枢状态汇报"
        echo "=================================================="
        case "${curr}" in
            auto)
                echo "📊 当前运行模式: 【AUTO 智能自适应模式】"
                echo "   • 高等模型 (Opus / Sonnet / Flash / GPT-4o 等):"
                echo "     - Superpowers 开工硬门禁: ✅ 生效"
                echo "     - 工具调用排版约束:       ❌ 自动静默 (无多余废话)"
                echo "   • 普通/轻量模型:"
                echo "     - Superpowers 开工硬门禁: ✅ 生效"
                echo "     - 工具调用排版约束:       ✅ 自动注入 (空行分段，杜绝黑盒)"
                ;;
            off)
                echo "⚡ 当前运行模式: 【OFF 强制全关闭】"
                echo "   - 所有提示词注入: ❌ 0 字符 (自由直接交付)"
                ;;
            on)
                echo "🛡️ 当前运行模式: 【ON 强制全开启】"
                echo "   - 所有模型强制注入: ✅ 硬门禁 + ✅ 工具排版透明规范"
                ;;
        esac
        echo "=================================================="
        ;;
    *)
        echo "用法: gate [toggle|auto|off|on|status]"
        exit 1
        ;;
esac
