#!/usr/bin/env python3
"""lmmcp-query — 查询 lmmcp 记忆，返回格式化上下文字符串。

优先使用 memory_context (综合语义+FTS)，回退到 memory_search (FTS)。
向量搜索 (memory_vector_search) 需要 Qdrant 运行，不可用时自动跳过。

用法:
  lmmcp-query "用户问题文本"
输出:
  找到记忆时: 格式化摘要字符串 (stdout)
  未找到时: 空字符串 (stdout)
  错误时: 错误信息 (stderr), exit 1
"""
from __future__ import annotations
import json
import sys
import urllib.request
import urllib.error

LMMCP_URL = "http://127.0.0.1:8318/mcp"
TIMEOUT = 6
CONTEXT_BUDGET = 1200
FTS_LIMIT = 5


def _mcp_session() -> str:
    """建立 MCP streamable-http 会话，返回 session_id。"""
    req = urllib.request.Request(
        LMMCP_URL,
        data=json.dumps({
            "jsonrpc": "2.0", "id": 0, "method": "initialize",
            "params": {
                "protocolVersion": "2024-11-05",
                "capabilities": {},
                "clientInfo": {"name": "lmmcp-query", "version": "1.1"}
            }
        }).encode(),
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
        },
        method="POST"
    )
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return resp.headers.get("Mcp-Session-Id", "")


def _mcp_call(session_id: str, tool: str, args: dict) -> dict:
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
    }
    if session_id:
        headers["Mcp-Session-Id"] = session_id
    req = urllib.request.Request(
        LMMCP_URL,
        data=json.dumps({
            "jsonrpc": "2.0", "id": 1,
            "method": "tools/call",
            "params": {"name": tool, "arguments": args}
        }).encode(),
        headers=headers,
        method="POST"
    )
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        body = resp.read().decode()
        for line in body.splitlines():
            if line.startswith("data:"):
                return json.loads(line[5:].strip())
    return {}


def _extract_text(result: dict) -> str:
    """从 MCP result 提取第一个 text content。"""
    content = result.get("result", {}).get("content", [])
    for item in content:
        if item.get("type") == "text":
            return item["text"]
    return ""


def query_memory(query: str) -> str:
    sid = _mcp_session()

    # 1. memory_context — 综合 FTS + 最近 + profile
    ctx_result = _mcp_call(sid, "memory_context", {
        "task": query,
        "token_budget": CONTEXT_BUDGET
    })
    ctx_text = _extract_text(ctx_result).strip()

    # 2. memory_search — FTS 补充
    fts_result = _mcp_call(sid, "memory_search", {
        "query": query,
        "limit": FTS_LIMIT
    })
    fts_text = _extract_text(fts_result).strip()

    # 组合
    parts = []
    if ctx_text and len(ctx_text) > 20:
        parts.append(ctx_text)
    if fts_text and len(fts_text) > 20:
        # 解析 FTS JSON lines
        items = []
        for line in fts_text.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
                title = d.get("title", "")
                content = d.get("content", "")[:200]
                tags = d.get("tags", [])
                tag_str = f" [{', '.join(tags[:3])}]" if tags else ""
                if title:
                    items.append(f"- {title}{tag_str}: {content}")
            except Exception:
                pass
        if items:
            parts.append("[相关记忆]\n" + "\n".join(items[:FTS_LIMIT]))

    if not parts:
        return ""

    return "\n\n".join(parts)


def main():
    if len(sys.argv) < 2:
        print("用法: lmmcp-query <query>", file=sys.stderr)
        sys.exit(1)

    query = " ".join(sys.argv[1:])
    try:
        result = query_memory(query)
        print(result)
    except urllib.error.URLError as e:
        print(f"lmmcp-query: 连接失败 {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"lmmcp-query: 错误 {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
